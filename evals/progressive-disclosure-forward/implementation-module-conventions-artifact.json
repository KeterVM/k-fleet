    "README.md": {
      "sha256": "1c5865d312e55dc94878d73f53b95e035024e5c809e957f3faf35ef168ad1c82",
      "content": "# Account app\n\nJavaScript ESM, no dependencies. Product features live under src/features.\nsrc/app.js composes their public entry points. Use named exports, camelCase names,\ntwo-space indentation, single quotes and semicolons as in the existing sources.\nRepositories are injected by the host.\n\nInvoice repository: repositories.invoices.load(id) returns an invoice with\nlines: [{quantity, unitPriceCents}]. Total is the sum of quantity times unit price,\nin integer cents. Negative or noninteger quantities and prices are invalid.\n"
    },
    "package.json": {
      "sha256": "67bf036e130c0a49ed6382244c295ba8bf8e9a3616d65d841183a8836a0e303d",
      "content": "{\"private\":true,\"type\":\"module\",\"scripts\":{\"test\":\"node --test\"}}\n"
    },
    "src/app.js": {
      "sha256": "f3d6f535e68bb3e976f28b1460a78ab63d9ad0856a8c83c60270edf4acc5b601",
      "content": "import { createProfileController } from './features/profile/index.js';\n\nexport function createApp(repositories) {\n  return { profile: createProfileController(repositories.profile) };\n}\n"
    },
    "src/features/profile/controller.js": {
      "sha256": "88d8426c2d2a6dc116863e9f3c7f06783cb0f50df82848c858d5b7f82e86e235",
      "content": "import { profileLabel } from './model.js';\n\nexport function createProfileController(repository) {\n  return { async label(id) { return profileLabel(await repository.load(id)); } };\n}\n"
    },
    "src/features/profile/index.js": {
      "sha256": "70a61568d68fe1a470c0953f41e15be2dc95bc0079afc8cd009d512ede2d56ab",
      "content": "export { createProfileController } from './controller.js';\n"
    },
    "src/features/profile/model.js": {
      "sha256": "75467d3446909d8a0fe9fd156acb9cbd2a3306e68b4de72bc72c48c0c23b0c72",
      "content": "export function profileLabel(profile) {\n  return profile.displayName.trim();\n}\n"
    }
  },
