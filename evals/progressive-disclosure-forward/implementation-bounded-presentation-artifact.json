    "README.md": {
      "sha256": "268cf462d94d1823761d511b6cd6f9a1d2fb46a0253efe5f50699223fb66fccb",
      "content": "# Profile card\n\nJavaScript ESM, no dependencies. This project deliberately separates view rendering\nunder src/views and pure data projection under src/models. The app composes them.\nKeep these boundaries and existing named exports, two-space indentation, single\nquotes and semicolons. Current profile values are trusted plain strings for this\ntext-only display. No test framework or test requirement is configured.\n"
    },
    "package.json": {
      "sha256": "67bf036e130c0a49ed6382244c295ba8bf8e9a3616d65d841183a8836a0e303d",
      "content": "{\"private\":true,\"type\":\"module\",\"scripts\":{\"test\":\"node --test\"}}\n"
    },
    "src/app.js": {
      "sha256": "f018b6efc7b9d3261369c7fa8f0e749d1fb8ab1cd7da6ddddeeff7169f66b89d",
      "content": "import { projectProfile } from './models/profile.js';\nimport { renderProfileCard } from './views/profile-card.js';\n\nexport function renderApp(record) {\n  return renderProfileCard(projectProfile(record));\n}\n"
    },
    "src/models/profile.js": {
      "sha256": "8811b3cbb240493dcd5d51334490fe9af052ca389a222a653ac594c4f4c66c1b",
      "content": "export function projectProfile(record) {\n  return { name: record.name, department: record.department };\n}\n"
    },
    "src/views/profile-card.js": {
      "sha256": "64b03385dd01f9bc17a0f87e38a431595b8e4a71a67771d62fd0719189e2cb7d",
      "content": "export function renderProfileCard(profile) {\n  return `Name: ${profile.name}`;\n}\n"
    }
  },
